IF NOT EXISTS (SELECT * FROM sys.schemas WHERE name = N'Subscription' )
BEGIN
EXECUTE('CREATE SCHEMA [Subscription]')
END
GO

IF NOT EXISTS (SELECT * FROM sys.tables t JOIN sys.schemas s ON (t.schema_id = s.schema_id) WHERE s.name = 'Subscription' AND t.name = 'Voucher')
BEGIN
CREATE TABLE [Subscription].[Voucher] (
    [VoucherId] INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [Code] NVARCHAR(1000) NOT NULL,
    [Redeemed] BIT NOT NULL DEFAULT(0)
    )
END
GO