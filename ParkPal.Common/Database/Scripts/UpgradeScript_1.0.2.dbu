IF NOT EXISTS (SELECT * FROM sys.tables t JOIN sys.schemas s ON (t.schema_id = s.schema_id) WHERE s.name = 'Notification' AND t.name = 'Type')
BEGIN
CREATE TABLE [Notification].[Type] (
    [TypeId] INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [Name] NVARCHAR(1000) NOT NULL
    )
END
GO

IF NOT EXISTS (SELECT * FROM [Notification].[Type] WHERE [TypeId] = 1)
BEGIN
    SET IDENTITY_INSERT [Notification].[Type] ON

    INSERT INTO [Notification].[Type] ([TypeId], [Name]) VALUES (1, 'Attraction')

    SET IDENTITY_INSERT [Notification].[Type] OFF
END
GO
    
IF NOT EXISTS (SELECT * FROM [Notification].[Type] WHERE [TypeId] = 2)
BEGIN
    SET IDENTITY_INSERT [Notification].[Type] ON

    INSERT INTO [Notification].[Type] ([TypeId], [Name]) VALUES (2, 'Park')

    SET IDENTITY_INSERT [Notification].[Type] OFF
END
GO
    
IF NOT EXISTS (SELECT * FROM sys.tables t JOIN sys.schemas s ON (t.schema_id = s.schema_id) WHERE s.name = 'Notification' AND t.name = 'Item')
BEGIN
CREATE TABLE [Notification].[Item] (
    [ItemId] INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [MinuteInterval] INT NOT NULL DEFAULT(5),
    [AttractionId] NVARCHAR(1000) NOT NULL,
    [ParkId] NVARCHAR(1000) NOT NULL,
    [TypeId] INT NOT NULL FOREIGN KEY REFERENCES [Notification].[Type](TypeId),
    [CriteriaType] INT NOT NULL FOREIGN KEY REFERENCES [Notification].[CriteriaType]([CriteriaTypeId]),
    [WaitTime] INT NOT NULL DEFAULT(20),
    [Enabled] BIT NOT NULL DEFAULT(1),
    [SubscriptionId] INT NOT NULL FOREIGN KEY REFERENCES [Notification].[Subscription]([SubscriptionId]),
    )
END
GO